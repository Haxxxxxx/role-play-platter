# Copy to .env.local and fill in.
# Used by both `npm run dev` (Vite, client-side only reads VITE_-prefixed
# vars) and `vercel dev` (also runs api/structure-gm-notes.ts locally, which
# reads the non-VITE_ server-only vars below via process.env).

# ── Client (public — safe to ship in the bundle) ───────────────────────────
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server only (never VITE_-prefixed, never shipped to the client) ────────
# Same Supabase project, but the service_role key (Project Settings -> API)
# — bypasses Row Level Security, used only by api/structure-gm-notes.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# aistudio.google.com/apikey -- free, no credit card needed. In production set this as a Vercel
# environment variable instead (`vercel env add GEMINI_API_KEY`) so it's
# never in a file at all.
GEMINI_API_KEY=
