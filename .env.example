# Copy to .env.local and fill in from Firebase console -> Project settings -> Your apps.
# These are public client identifiers (safe to ship in the bundle) — they are
# NOT secrets. Firestore security rules (firestore.rules) are what actually
# protect the data, not this config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
