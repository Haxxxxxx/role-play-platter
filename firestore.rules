rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCampaignMember(campaignId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.memberIds;
    }

    match /campaigns/{campaignId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.gmId &&
        request.auth.uid in request.resource.data.memberIds;
      // Any member can update (e.g. inviting another player onto memberIds);
      // the GM identity itself can't be reassigned from the client.
      allow update: if isCampaignMember(campaignId) &&
        request.resource.data.gmId == resource.data.gmId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.gmId;

      // Chronicle collections: any campaign member can read/write by hand,
      // but the AI pipeline itself always runs through the Cloud Function
      // (admin SDK, bypasses these rules) so a client can't spoof an
      // "AI-structured" entry by writing sourceNoteId/status fields directly
      // with confidence they'll be trusted elsewhere in the app.
      match /party/{characterId} {
        allow read, write: if isCampaignMember(campaignId);
      }

      match /sessionNotes/{noteId} {
        allow read: if isCampaignMember(campaignId);
        allow create: if isCampaignMember(campaignId) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.status == 'pending';
        // Clients may only edit their own still-pending note (e.g. fixing a
        // typo before processing); everything past that point is the
        // Cloud Function's job.
        allow update: if isCampaignMember(campaignId) &&
          resource.data.authorId == request.auth.uid &&
          resource.data.status == 'pending';
        allow delete: if false;
      }

      match /timeline/{eventId} {
        allow read: if isCampaignMember(campaignId);
        allow write: if isCampaignMember(campaignId);
      }

      match /npcs/{npcId} {
        allow read, write: if isCampaignMember(campaignId);
      }

      match /locations/{locationId} {
        allow read, write: if isCampaignMember(campaignId);
      }

      match /quests/{questId} {
        allow read, write: if isCampaignMember(campaignId);
      }

      match /maps/{mapId} {
        allow read, write: if isCampaignMember(campaignId);
      }
    }
  }
}
